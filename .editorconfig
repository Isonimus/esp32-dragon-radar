# EditorConfig: consistent whitespace across editors. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Node scripts and their tests use 2-space indents.
[*.{mjs,js}]
indent_size = 2

# YAML and JSON: 2-space is the ecosystem norm.
[*.{yml,yaml,json}]
indent_size = 2

# Markdown: trailing whitespace is significant (two-space hard line breaks).
[*.md]
trim_trailing_whitespace = false
